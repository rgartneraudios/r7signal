{
  "$schema": "../schemas/desktop-schema.json",
  "identifier": "cochi-full-access",
  "description": "Cochi Desktop full system access",
  "windows": ["main"],
  "permissions": [
    "core:path:allow-resolve-directory",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:scope-applocaldata-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ],
      "deny": [
        { "url": "http://localhost/**" },
        { "url": "https://localhost/**" },
        { "url": "http://127.*.*.*/**" },
        { "url": "https://127.*.*.*/**" },
        { "url": "http://0.*.*.*/**" },
        { "url": "https://0.*.*.*/**" },
        { "url": "http://10.*.*.*/**" },
        { "url": "https://10.*.*.*/**" },
        { "url": "http://169.254.*.*/**" },
        { "url": "https://169.254.*.*/**" },
        { "url": "http://172.16.*.*/**" },
        { "url": "https://172.16.*.*/**" },
        { "url": "http://172.17.*.*/**" },
        { "url": "https://172.17.*.*/**" },
        { "url": "http://172.18.*.*/**" },
        { "url": "https://172.18.*.*/**" },
        { "url": "http://172.19.*.*/**" },
        { "url": "https://172.19.*.*/**" },
        { "url": "http://172.20.*.*/**" },
        { "url": "https://172.20.*.*/**" },
        { "url": "http://172.21.*.*/**" },
        { "url": "https://172.21.*.*/**" },
        { "url": "http://172.22.*.*/**" },
        { "url": "https://172.22.*.*/**" },
        { "url": "http://172.23.*.*/**" },
        { "url": "https://172.23.*.*/**" },
        { "url": "http://172.24.*.*/**" },
        { "url": "https://172.24.*.*/**" },
        { "url": "http://172.25.*.*/**" },
        { "url": "https://172.25.*.*/**" },
        { "url": "http://172.26.*.*/**" },
        { "url": "https://172.26.*.*/**" },
        { "url": "http://172.27.*.*/**" },
        { "url": "https://172.27.*.*/**" },
        { "url": "http://172.28.*.*/**" },
        { "url": "https://172.28.*.*/**" },
        { "url": "http://172.29.*.*/**" },
        { "url": "https://172.29.*.*/**" },
        { "url": "http://172.30.*.*/**" },
        { "url": "https://172.30.*.*/**" },
        { "url": "http://172.31.*.*/**" },
        { "url": "https://172.31.*.*/**" },
        { "url": "http://192.168.*.*/**" },
        { "url": "https://192.168.*.*/**" },
        { "url": "http://*::1*/**" },
        { "url": "https://*::1*/**" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "shell:default",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": ["-Command", { "validator": ".*" }],
          "sidecar": false
        }
      ]
    },
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "opener:default"
  ]
}
