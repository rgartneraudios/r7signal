# R7 Desktop — environment template.
# Copy to .env (gitignored) and fill in your own values. Never commit .env.
#
# THE VITE_ RULE
# Vite inlines every variable prefixed with VITE_ into the compiled bundle.
# Anything with that prefix is PUBLIC: whoever downloads the build can read it.
# Never give a secret the VITE_ prefix. Secrets stay unprefixed and server-side.

# --- Supabase (optional; the app runs without it) ---
# Public by design (protected by row level security), safe behind VITE_.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Development flags ---
# Vite inlines this too, but it is not a secret. Set to true to enable React StrictMode.
VITE_STRICT=false

# --- Dev only, never inlined into the bundle (no VITE_ prefix) ---
# Used by the Supabase edge functions and by local end-to-end runs.
# The desktop app itself takes the user's key from local_config.json (AppLocalData), not from here.
OPENROUTER_API_KEY=your-openrouter-key

# Server-side only. Never expose it to the client, never prefix it with VITE_.
# Supabase injects it into edge functions automatically; fill it only when a local tool needs it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
